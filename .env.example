# 应用配置
APP_NAME=EventDrive
APP_VERSION=1.0.0
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./data/db.sqlite3

# ---- 云数据库（WorkBuddy Cloud /PostgREST）----
#
# 沙箱部署没有持久磁盘，SQLite 重启即丢；启用下面三项后，
# **快照类小表**（宏观指标 / 股市热度 / 各自历史 / 抓取日志）改走云库持久化，
# 其余表（新闻、指数历史、财务、热点、行情）仍在本地 SQLite（第二步再迁）。
#
# 三项必须齐备才启用；缺任一项自动退回 SQLite（本地开发零依赖）。
# 鉴权 header 是 x-wb-webapp-access-key（不是 apikey / Authorization）。
#
# ⚠ 缺省值（app/config.py 里）已指向本应用自己的 publicConfig，线上零配置即可用。
# 本地想继续用 SQLite，把下面一行取消注释即可（本地 .env 优先级高于缺省值）：
# CLOUD_DB_ENABLED=false
# CLOUD_DB_ENDPOINT=https://<app-domain>
# CLOUD_DB_KEY=wbpk_xxx

# 抓取配置
CRAWL_INTERVAL_HOURS=6
NEWS_PER_SOURCE=10
NEWS_TIME_RANGE_HOURS=24

# 反爬虫配置
MIN_DELAY=2
MAX_DELAY=5

# ---- 抓取限流（防止频繁抓取 / 单次抓取过多触发来源方风控）----
# 按 host（域名）独立计量，同一 host 两次请求强制最小间隔。
# RATE_LIMIT_MIN_INTERVAL=3.0
# 令牌桶容量：允许的突发请求数
# RATE_LIMIT_BURST=3
# 每个 host 每天最多请求次数（0 = 不限制）
# RATE_LIMIT_DAILY_QUOTA=200
# 单次抓取任务内，单个 host 最多发起几次请求
# RATE_LIMIT_MAX_REQS_PER_RUN=12
# 失败退避：连续失败按 基数 * 2^n 增长，封顶 BACKOFF_MAX 秒
# RATE_LIMIT_BACKOFF_BASE=60
# RATE_LIMIT_BACKOFF_MAX=1800
# 触发限流后跳过本轮（true）还是等待到冷却结束（false）
# RATE_LIMIT_SKIP_ON_EXCEED=true
# 单个任务每日最多执行次数（用于 akshare 等内部封装、无法逐请求插桩的来源）
# 页面手动刷新 + 定时任务叠加也受此保护
# TASK_DAILY_QUOTA=8

# ============================================================
# 定时任务调度
# ============================================================
# Web 进程内是否内嵌定时任务（新闻抓取 + 行情 + 宏观指标）
#   true  : Web 进程自己跑定时任务（本地开发最省事）
#   false : Web 只提供 API，定时任务交给独立进程 run_scheduler.py / start.sh
# START_SCHEDULER=false
#
# 宏观指标（资金面 / 经济热度）的抓取已挂在同一个调度器上，与新闻/行情同一节奏
# （JST 8:00/12:00/16:00/20:00），无需额外配置项。
#
# 页面打开时的惰性抓取兜底：缓存有效期（小时）
# MACRO_CACHE_TTL_HOURS=12
