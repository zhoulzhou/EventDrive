# 应用配置
APP_NAME=EventDrive
APP_VERSION=1.0.0
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./data/db.sqlite3

# 抓取配置
CRAWL_INTERVAL_HOURS=6
NEWS_PER_SOURCE=10
NEWS_TIME_RANGE_HOURS=24

# 反爬虫配置
MIN_DELAY=2
MAX_DELAY=5

# 图片存储路径
IMAGES_DIR=./data/images

# 飞书推送配置 (可选)
# 获取方式: 飞书开放平台 -> 群机器人 -> Webhook
# FEISHU_WEBHOOK_URL= https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# FEISHU_SECRET= xxx (可选，留空则不启用签名验证)
# FEISHU_KEYWORD=头条 (推送消息必须包含此关键词才发送)

# 纽约时报飞书推送配置 (可选)
# NYT_FEISHU_WEBHOOK_URL= https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# NYT_FEISHU_KEYWORD=HOT (推送消息必须包含此关键词才发送)

# BBC飞书推送配置 (可选)
# BBC_FEISHU_WEBHOOK_URL= https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# BBC_FEISHU_KEYWORD=HOT (推送消息必须包含此关键词才发送)

# 知识库分析配置
# KB_ACCOUNT_ID=2123896104
# KB_APIKEY=your_api_key_here
# KB_SERVICE_RESOURCE_ID=kb-service-xxx
# KB_DOMAIN=api-knowledgebase.mlp.cn-beijing.volces.com
# KB_FEISHU_WEBHOOK_URL= https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# KB_KEYWORD=Talk

# DeepSeek V4 大模型分析配置 (可选)
# 获取方式: https://platform.deepseek.com -> API Keys
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_FEISHU_WEBHOOK_URL= https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# DEEPSEEK_KEYWORD=深度分析

# ===================================================
# 飞书互动助手配置 (bot/ 独立模块，不影响上面新闻系统)
# ===================================================

# 当前使用的大模型类型 (可选: deepseek / doubao / openrouter)
# BOT_AI_MODEL=deepseek

# 飞书应用凭证 (WebSocket 长连接机器人)
# 获取方式: 飞书开放平台 -> 创建应用 -> 凭证与基础信息
# BOT_FEISHU_APP_ID=cli_xxx
# BOT_FEISHU_APP_SECRET=xxx

# DeepSeek 模型配置 (BOT_AI_MODEL=deepseek 时使用)
# BOT_DEEPSEEK_API_KEY=sk-xxx
# BOT_DEEPSEEK_MODEL=deepseek-v4-pro

# 豆包模型配置 (BOT_AI_MODEL=doubao 时使用)
# BOT_DOUBAO_API_KEY=xxx
# BOT_DOUBAO_MODEL=doubao-1-5-pro-32k-250115
# BOT_DOUBAO_REGION=cn-beijing

# OpenRouter 模型配置 (BOT_AI_MODEL=openrouter 时使用)
# BOT_OPENROUTER_API_KEY=sk-or-v1-xxx

# ===================================================
# X (Twitter) 平台配置
# ===================================================

# X API 凭证 (必填)
# 获取方式: X Developer Portal -> Projects & Apps -> Keys and tokens
# X_BEARER_TOKEN=xxx
# X_CONSUMER_KEY=xxx
# X_CONSUMER_SECRET=xxx
# X_ACCESS_TOKEN=xxx
# X_ACCESS_TOKEN_SECRET=xxx

# 要抓取的用户 ID
# X_USER_ID=xxx

# 要抓取的列表 ID（可通过 run_x.py lists 查看所有列表）
# X_LIST_ID=xxx

# X 飞书推送配置 (可选)
# X_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/76b00cec-a6f2-4f7f-b0be-e5b98a05a0de
# X_FEISHU_KEYWORD=X推文

# X 抓取限制配置 (可选)
# X_MAX_RESULTS=5
# X_MONTH_MAX_LIMIT=190
# X_DAY_MAX_LIMIT=6
