# 应用配置
APP_NAME=EventDrive
APP_VERSION=1.0.0
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./data/db.sqlite3

# 抓取配置
CRAWL_INTERVAL_HOURS=6
NEWS_PER_SOURCE=10
NEWS_TIME_RANGE_HOURS=24

# 反爬虫配置
MIN_DELAY=2
MAX_DELAY=5

# ===================================================
# X (Twitter) 平台配置
# ===================================================

# X API 凭证 (必填)
# 获取方式: X Developer Portal -> Projects & Apps -> Keys and tokens
# X_B_T=xxx
# X_CONSUMER_KEY=xxx
# X_CONSUMER_SECRET=xxx
# X_ACCESS_TOKEN=xxx
# X_ACCESS_TOKEN_SECRET=xxx

# 要抓取的用户 ID
# X_USER_ID=xxx

# 要抓取的列表 ID（可通过 run_x.py lists 查看所有列表）
# X_LIST_ID=xxx

# X 抓取限制配置 (可选)
# X_MAX_RESULTS=5
# X_MONTH_MAX_LIMIT=190
# X_DAY_MAX_LIMIT=6

# ============================================================
# 定时任务调度
# ============================================================
# Web 进程内是否内嵌定时任务（新闻抓取 + 行情 + 宏观指标）
#   true  : Web 进程自己跑定时任务（本地开发最省事）
#   false : Web 只提供 API，定时任务交给独立进程 run_scheduler.py / start.sh
# START_SCHEDULER=false
#
# 宏观指标（资金面 / 经济热度）的抓取已挂在同一个调度器上，与新闻/行情同一节奏
# （JST 8:00/12:00/16:00/20:00），无需额外配置项。
#
# 页面打开时的惰性抓取兜底：缓存有效期（小时）
# MACRO_CACHE_TTL_HOURS=12
