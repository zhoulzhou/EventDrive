*.sqlite3-shm
*.sqlite3-wal

# 数据库备份目录(不忽略, 纳入 git 管理, 便于提交备份)
!backup/
!backup/*.sqlite3

# Logs
*.log
logs/
nohup.out

# Runtime data
data/images/
data/x_twitter_quota.json
data/x_twitter_state.json
data/history_tweet_cache.json
*.pid

# Temporary files
*.tmp
.DS_Store
Thumbs.db

# 本地智能体工作目录(memory 等个人上下文, 不入库)
.workbuddy/

# 调试截图(页面实拍校验产物)
docs/_charts/
docs/*.png

# Test/debug scripts
test_*.py
debug_*.py
check_*.py
minimal*.py
simple*.py
ultra_simple.py
direct_start.py
subprocess_start.py
start_*.py
final_*.py
launch.py
run_crawl*.py
check_news.py
sqlite_query.py
api_response.json

# WorkBuddy 发布工具生成的本地标记文件（含本机绝对路径，不应入库）
.wbapp_*.genie

# 定时任务配置仓库（独立推送到GitHub，不属于业务代码）
.cron/
.cron-scf/

# 本地临时验证目录（venv +探测产物），不应入库
.tmp_probe/
.tmp_v/
# 页面实拍校验用的临时脚本与 PNG（Chrome CDP 截图）
.tmp/

# 离线预览产物（用真实 API 数据渲染的静态页），不应入库
preview_panic/

# 调试用会话 cookie 与接口响应转储（含登录态），不入库
data/_ck.txt
data/_s*.json
